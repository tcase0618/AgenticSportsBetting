  "ncaaf": {
    "sport": "ncaaf",
    "name": "Rested Conference Dogs",
    "rule": "In CONFERENCE games, bet the ATS underdog of roughly 7+ points (market win prob <= 30%) when it has 2+ more days of rest than its opponent (e.g. off a bye or Thursday game).",
    "why": "Extra preparation is worth more against a familiar conference opponent, and big spreads price talent gaps rather than prep and scheme. The same spot outside conference play (cupcake mismatches) shows no edge, which is why the conference filter is part of the rule.",
